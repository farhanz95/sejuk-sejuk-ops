> Copy to `.env` and fill in — none of these are required to run the demo.

# ---- Supabase (optional) ---------------------------------------------------
# Leave BOTH unset to run on the built-in seeded demo dataset (localStorage).
# Set both to switch the app to the cloud database + storage.
# 1. create a project at https://supabase.com
# 2. run supabase/schema.sql, then supabase/seed.sql in the SQL editor
# 3. paste the Project URL + anon key here
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server-side values (Vercel env vars, never exposed to the browser) ----
# The AI query API reads the database itself. Use the anon key, or the service
# role key if you also want the endpoint to bypass RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider (optional) ------------------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, DeepSeek, Groq, Together,
# OpenRouter, a local llama.cpp server, ...
# With no key set, the AI window still answers using the deterministic intent
# matcher + templated phrases (same controlled queries, no LLM).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Example — DeepSeek:
# AI_API_KEY=sk-xxxx
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
#
# Example — Groq (free tier; this is what the live demo uses):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b        # or qwen/qwen3.8-27b
#   measured 2026-09-10: both return proper tool_calls for the planner; the
#   text models on this key (llama-3.x) are 404, so pick from GET /v1/models.
