{
  "name": "sejuk-sejuk-ops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sejuk Sejuk Service — internal operations system (orders → assignment → field completion → manager review), with an AI operations query window. Built for the Programmer Assessment.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
